<script>
    const products = @Json.Serialize(DemoData.Products);
</script>
<script src="~/js/dataGridLocal.js" asp-append-version="true"></script>
<script src="~/js/dataGridRemote.js" asp-append-version="true"></script>

@(Html.DevExtreme().TabPanel()
    .ID("tab-panel")
    .DeferRendering(false)
    .Items(items => {
        items.Add().Title("Local Data").Template(@<text>
            <div class="tab-item-content">
                @await Html.PartialAsync("_DataGridLocal")
            </div>
        </text>);
        items.Add().Title("Remote Data").Template(@<text>
            <div class="tab-item-content">
                @await Html.PartialAsync("_DataGridRemote")
            </div>
        </text>);
    })
)
